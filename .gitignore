# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.vsconfig

# Excluded large content (re-downloadable from Quixel Bridge)
Content/MetaHumans/
Content/Main/Christopher/Animations/
Content/Main/Christopher/Base/
Content/Main/Christopher/C++_Classes/
Content/Main/Christopher/Chris_Metahuman/
Content/Main/Christopher/DeadStuff/
Content/Main/Christopher/GAS/
Content/Main/Christopher/Grooms/
Content/Main/Christopher/Face/
Content/Main/Christopher/KOM_Character/
Content/Main/Christopher/MAT_Locodrome/
Content/Main/Christopher/Player_Art_Assets/
Content/Main/Christopher/Test/
Content/ParagonTerra/

# Marketplace content packs (redownloadable from Epic Launcher Vault)
Content/SkeletonCharacter/
Content/RealisticBlood/
Content/QuangPhan/
Content/Dodge_Animations/
Content/Characters/
Content/ProjectileHitVFX/
Content/BattleMage/
Content/KOM_Character/

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/**/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/**/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*
